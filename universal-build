#!/usr/bin/env sh
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"

SCRIPT_NAME="${0##*/}"
NIX_VERSION="nixpkgs#nixVersions.nix_2_31"

fail() {
  printf '\033[31mUniversal Build: %s\033[0m\n' "$@" >&2
  printf '\033[31mUniversal Build: BUILD FAILED\033[0m\n' >&2
  exit 1
}

usage() {
  printf 'Universal Build: Usage:\n'
  printf '  %s build                    # build, test, check, and package the project\n' "$SCRIPT_NAME"
  printf '  %s ide-paths                # print toolchain paths for IDE setup\n' "$SCRIPT_NAME"
  printf '  %s clean                    # remove build/\n' "$SCRIPT_NAME"
  printf '  %s update-toolchain-lock    # update the Nix flake lockfile\n' "$SCRIPT_NAME"
  printf '  %s update-idiomatic-lock    # update the language dependency lockfile\n' "$SCRIPT_NAME"
}

validate_args() {
  if [ "$#" -ne 1 ]; then
    fail "$(usage)"
  fi

  case "$1" in
    build|clean|ide-paths|update-toolchain-lock|update-idiomatic-lock)
      ;;
    *)
      fail "Unknown command: $1" "$(usage)"
      ;;
  esac
}

require_file() {
  [ -f "$SCRIPT_DIR/$1" ] ||
    fail "Missing $1 in $SCRIPT_DIR. $2"
}

validate_project_files() {
  require_file flake.nix "Define the nixpkgs input and buildtime shell there."
  if [ "$1" != update-toolchain-lock ]; then
    require_file flake.lock "Run ./$SCRIPT_NAME update-toolchain-lock in the project root, then commit flake.lock."
  fi
}

validate_buildtime() {
  in_buildtime true ||
    fail "Could not load flake.nix#buildtime. Fix the Nix error above."
}

validate_build_command() {
  BUILD_COMMAND="$(in_buildtime sh -eu -c 'printf "%s" "${BUILD_COMMAND:-}"')"
  [ -n "$BUILD_COMMAND" ] ||
    fail "Missing BUILD_COMMAND. Define the build shell command in flake.nix#buildtime."
}

validate_ide_paths() {
  in_buildtime sh -eu -c '[ -n "${IDE_PATH_VARS:-}" ]' ||
    fail "Missing IDE_PATH_VARS. List the environment variable names for IDE paths in flake.nix#buildtime."
}

validate_idiomatic_lock_command() {
  in_buildtime sh -eu -c '[ -n "${UPDATE_IDIOMATIC_LOCK_COMMAND:-}" ]' ||
    fail "Missing UPDATE_IDIOMATIC_LOCK_COMMAND. Define the lock update command in flake.nix#buildtime."
}

validate_release_type() {
  RELEASE_TYPE="$(in_buildtime sh -eu -c 'printf "%s" "${RELEASE_TYPE:-}"')"
  case "$RELEASE_TYPE" in
    container)
      require_file Dockerfile "Container releases require a Dockerfile."
      ;;
    static)
      ;;
    *)
      fail "RELEASE_TYPE must be container or static in flake.nix#buildtime; got '$RELEASE_TYPE'."
      ;;
  esac
}

validate_idiomatic_artifacts() {
  [ -d build/release/idiomatic-artifacts ] ||
    fail "BUILD_COMMAND must create build/release/idiomatic-artifacts/ with all deployable files."
  [ -n "$(find build/release/idiomatic-artifacts -type f -print -quit)" ] ||
    fail "build/release/idiomatic-artifacts/ is empty. BUILD_COMMAND must stage all deployable files there."
}

validate_runtime() {
  [ -f "$RUNTIME_PATH/bin/ignite" ] && [ -x "$RUNTIME_PATH/bin/ignite" ] ||
    fail "The flake runtime package must produce executable bin/ignite."
}

require_nix() {
  if ! command -v nix >/dev/null 2>&1; then
    fail "Error: Nix is required. Install from https://nix.dev/install-nix"
  fi
}

pinned_nix() {
  nix \
    --extra-experimental-features 'nix-command flakes' \
    --option warn-dirty false \
    shell \
    --no-update-lock-file \
    --inputs-from "$SCRIPT_DIR" \
    "$NIX_VERSION" \
    --command nix --extra-experimental-features 'nix-command flakes' --option warn-dirty false "$@"
}

in_buildtime() {
  pinned_nix \
    develop \
    --no-update-lock-file \
    "$SCRIPT_DIR#buildtime" \
    --command "$@"
}

update_toolchain_lock() {
  cd "$SCRIPT_DIR"
  if [ -f flake.lock ]; then
    pinned_nix flake update ||
      fail "Could not update flake.lock. Fix the Nix error above."
  else
    nix \
      --extra-experimental-features 'nix-command flakes' \
      --option warn-dirty false \
      shell \
      --inputs-from "$SCRIPT_DIR" \
      "$NIX_VERSION" \
      --command nix --extra-experimental-features 'nix-command flakes' --option warn-dirty false flake lock ||
      fail "Could not create flake.lock. Fix the Nix error above."
  fi
}

ide_paths() {
  in_buildtime sh -efu -c '
    for name in $IDE_PATH_VARS; do
      printf "\033[36mUniversal Build: %s=\033[0m" "$name"
      printenv "$name"
    done
  ' ||
    fail "Could not print IDE paths. Ensure every variable in IDE_PATH_VARS is defined in flake.nix#buildtime."
}

update_idiomatic_lock() {
  cd "$SCRIPT_DIR"
  in_buildtime sh -eu -c 'exec sh -eu -c "$UPDATE_IDIOMATIC_LOCK_COMMAND"' ||
    fail "Could not update the idiomatic dependency lockfile."
}

package_runtime() {
  RUNTIME_PATH="$(pinned_nix \
    build \
    --no-update-lock-file \
    --out-link "$SCRIPT_DIR/build/release/symlink-to-absolute-ignite-script" \
    --print-out-paths \
    "$SCRIPT_DIR#runtime")" ||
    fail "Could not build the flake runtime package. Define packages.<system>.runtime and fix the Nix error above."

  validate_runtime

  pinned_nix \
    copy \
    --no-check-sigs \
    --to "$SCRIPT_DIR/build/release/runtime-artifacts" \
    "$RUNTIME_PATH" ||
      fail "Could not copy the runtime dependency closure. Fix the Nix error above."
}

package_release() {
  if [ "$RELEASE_TYPE" = container ]; then
    cp Dockerfile build/release/Dockerfile
  fi

  in_buildtime tar \
    --create \
    --gzip \
    --file "$SCRIPT_DIR/build/release-artifact.tar.gz" \
    --directory "$SCRIPT_DIR/build/release" \
    . ||
    fail "Could not create build/release-artifact.tar.gz."
}

clean() {
  # Nix copies directories as read-only; make them writable before removing build/.
  if [ -d "$SCRIPT_DIR/build" ]; then
    find "$SCRIPT_DIR/build" -type d -exec chmod u+w {} + ||
      fail "Could not make build/ writable."
  fi
  rm -rf "$SCRIPT_DIR/build" ||
    fail "Could not remove build/."
}

build() {
  cd "$SCRIPT_DIR"

  # Nix copies directories as read-only; make them writable so cleanup can remove their contents.
  if [ -d build/release ]; then
    find build/release -type d -exec chmod u+w {} +
  fi
  rm -rf build/release
  rm -f build/release-artifact.tar.gz

  printf '\033[36mUniversal Build: Running idiomatic build; release packaging follows.\033[0m\n'
  in_buildtime sh -eu -c 'exec sh -eu -c "$BUILD_COMMAND"' ||
    fail "Idiomatic build failed."
  printf '\033[36mUniversal Build: Idiomatic build succeeded. Packaging release…\033[0m\n'
  validate_idiomatic_artifacts

  if [ "$RELEASE_TYPE" = container ]; then
    package_runtime
  fi

  package_release
  printf '\033[32mUniversal Build: BUILD AND PACKAGING SUCCESSFUL\033[0m\n'
}

main() {
  validate_args "$@"

  case "$1" in
    build)
      validate_project_files "$1"
      require_nix
      validate_buildtime
      validate_build_command
      validate_release_type
      build
      ;;
    clean)
      clean
      printf '\033[32mUniversal Build: CLEAN SUCCESSFUL\033[0m\n'
      ;;
    update-toolchain-lock)
      validate_project_files "$1"
      require_nix
      update_toolchain_lock
      printf '\033[32mUniversal Build: TOOLCHAIN LOCK UPDATE SUCCESSFUL\033[0m\n'
      ;;
    ide-paths)
      validate_project_files "$1"
      require_nix
      validate_buildtime
      validate_ide_paths
      ide_paths
      printf '\033[32mUniversal Build: IDE PATHS PRINTED SUCCESSFULLY\033[0m\n'
      ;;
    update-idiomatic-lock)
      validate_project_files "$1"
      require_nix
      validate_buildtime
      validate_idiomatic_lock_command
      update_idiomatic_lock
      printf '\033[32mUniversal Build: IDIOMATIC LOCK UPDATE SUCCESSFUL\033[0m\n'
      ;;
  esac
}

main "$@"
